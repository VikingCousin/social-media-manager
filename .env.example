# Kopiere diese Datei nach .env.local und trage deinen eigenen Schlüssel ein.
# Ein Claude-Abo (Claude.ai / Claude Code) ist KEIN API-Zugang – den Schlüssel
# erzeugst du unter https://console.anthropic.com (API-Nutzung wird separat abgerechnet).
ANTHROPIC_API_KEY=

# Optional: Modell für KI-Funktionen (kann auch unter Einstellungen geändert werden)
ANTHROPIC_MODEL=claude-opus-5

# Optional: Pfad zur SQLite-Datenbank (Standard: ./data/contentkompass.db)
# CONTENTKOMPASS_DB=./data/contentkompass.db

# --- Nur für den Zugriff über Tailscale (siehe docs/IPHONE-ZUGRIFF.md) ---
# Freigegebene Tailscale-Logins (kommagetrennt). Leer = Sperre aus; der Server ist dann
# ohnehin nur auf dem Mac selbst erreichbar (127.0.0.1).
# CK_ALLOWED_TAILSCALE_LOGINS=
# Tailscale-Adresse des Macs, falls Server-Aktionen über Tailscale mit
# „Invalid Server Actions request“ abgelehnt werden:
# CK_ALLOWED_ORIGINS=

# --- Plattform-Verbindungen (siehe docs/VERBINDUNGEN.md) ---
# Werte selbst eintragen, nie in den Chat oder in Git.
# LinkedIn (Rückleitung http://localhost:3210/api/oauth/linkedin/callback)
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# LINKEDIN_SCOPES=openid profile w_member_social
# LINKEDIN_API_VERSION=202609
# TikTok und Instagram verlangen eine HTTPS-Rückleitung (z. B. private Tailscale-Adresse)
# CK_HTTPS_BASE_URL=https://<geraetename>.<tailnet>.ts.net
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# TIKTOK_SCOPES=user.info.basic,user.info.profile
# INSTAGRAM_APP_ID=
# INSTAGRAM_APP_SECRET=
# INSTAGRAM_SCOPES=instagram_business_basic
# Optional: eigener Schlüssel für die Token-Verschlüsselung (32 Byte, base64). Sonst wird data/token.key erzeugt.
# CK_TOKEN_KEY=
