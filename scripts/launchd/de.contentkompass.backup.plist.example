<?xml version="1.0" encoding="UTF-8"?>
<!--
  VORLAGE – wird nicht automatisch installiert.
  Erstellt täglich um 21:30 ein konsistentes Backup nach backups/ im Projektordner.
  Optional: Zielordner als weiteres Argument anhängen (z. B. externer Datenträger).
  Installation siehe docs/IPHONE-ZUGRIFF.md, Schritt 5.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>de.contentkompass.backup</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd "/PFAD/ZUM/social-media-manager" &amp;&amp; npm run backup</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>21</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/tmp/contentkompass-backup.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/contentkompass-backup.err.log</string>
</dict>
</plist>
