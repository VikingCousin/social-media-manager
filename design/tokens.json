{
  "$description": "Social Media Manager – Design-Tokens mit neutralen Standardwerten (W3C-Format, Rollennamen wie color.text.primary). Einzige Quelle für Oberfläche, App-Symbol und Manifest. Alle Werte sind ARBEITSWERTE und markenseitig OFFEN – siehe design/BRAND-STATUS.md.",
  "$extensions": {
    "de.smm.status": {
      "brandKit": "ENTWURF",
      "values": "ARBEITSWERTE (OFFEN)"
    }
  },
  "color": {
    "brand": {
      "primary": {
        "$type": "color",
        "$value": "#1f5f5b",
        "$extensions": {
          "de.smm.mode.dark": "#7cc3bb"
        },
        "$description": "OFFEN – Arbeitswert, keine freigegebene Markenfarbe"
      }
    },
    "bg": {
      "canvas": {
        "$type": "color",
        "$value": "#f6f5f1",
        "$extensions": {
          "de.smm.mode.dark": "#151819"
        }
      },
      "surface": {
        "$type": "color",
        "$value": "#ffffff",
        "$extensions": {
          "de.smm.mode.dark": "#1c2021"
        }
      },
      "surface-sunken": {
        "$type": "color",
        "$value": "#fbfaf7",
        "$extensions": {
          "de.smm.mode.dark": "#202526"
        }
      }
    },
    "text": {
      "primary": {
        "$type": "color",
        "$value": "#1d2327",
        "$extensions": {
          "de.smm.mode.dark": "#e8e6e1"
        }
      },
      "secondary": {
        "$type": "color",
        "$value": "#4a545b",
        "$extensions": {
          "de.smm.mode.dark": "#bfc3c2"
        }
      },
      "tertiary": {
        "$type": "color",
        "$value": "#636a70",
        "$extensions": {
          "de.smm.mode.dark": "#8b9293"
        },
        "$description": "[Projekt-Erweiterung] Hinweis- und Metatext; muss ≥ 4,5:1 erreichen"
      },
      "link": {
        "$type": "color",
        "$value": "#1f5f5b",
        "$extensions": {
          "de.smm.mode.dark": "#7cc3bb"
        }
      },
      "on-action": {
        "$type": "color",
        "$value": "#ffffff",
        "$extensions": {
          "de.smm.mode.dark": "#0f1a19"
        }
      }
    },
    "border": {
      "default": {
        "$type": "color",
        "$value": "#e4e1d8",
        "$extensions": {
          "de.smm.mode.dark": "#2e3436"
        },
        "$description": "Dekorative Trennlinien (Karten, Listen) – nicht zur Erkennung von Bedienelementen"
      },
      "subtle": {
        "$type": "color",
        "$value": "#efece5",
        "$extensions": {
          "de.smm.mode.dark": "#262b2c"
        }
      },
      "strong": {
        "$type": "color",
        "$value": "#8d8a81",
        "$extensions": {
          "de.smm.mode.dark": "#6d7172"
        },
        "$description": "Rahmen von Bedienelementen (Eingabefelder, Auswahl, Buttons) – ≥ 3:1"
      }
    },
    "action": {
      "primary": {
        "bg": {
          "$type": "color",
          "$value": "#1f5f5b",
          "$extensions": {
            "de.smm.mode.dark": "#7cc3bb"
          }
        },
        "text": {
          "$type": "color",
          "$value": "#ffffff",
          "$extensions": {
            "de.smm.mode.dark": "#0f1a19"
          }
        }
      }
    },
    "selection": {
      "bg": {
        "$type": "color",
        "$value": "#e3efed",
        "$extensions": {
          "de.smm.mode.dark": "#1f3432"
        }
      },
      "text": {
        "$type": "color",
        "$value": "#1f5f5b",
        "$extensions": {
          "de.smm.mode.dark": "#7cc3bb"
        }
      }
    },
    "feedback": {
      "success": {
        "bg": {
          "$type": "color",
          "$value": "#e3f1e6",
          "$extensions": {
            "de.smm.mode.dark": "#1f3325"
          }
        },
        "text": {
          "$type": "color",
          "$value": "#2d6a3e",
          "$extensions": {
            "de.smm.mode.dark": "#86c996"
          }
        }
      },
      "warning": {
        "bg": {
          "$type": "color",
          "$value": "#fbf1dc",
          "$extensions": {
            "de.smm.mode.dark": "#3a3020"
          }
        },
        "text": {
          "$type": "color",
          "$value": "#8a5a00",
          "$extensions": {
            "de.smm.mode.dark": "#e2b760"
          }
        }
      },
      "error": {
        "bg": {
          "$type": "color",
          "$value": "#f8e5e1",
          "$extensions": {
            "de.smm.mode.dark": "#3d2522"
          }
        },
        "text": {
          "$type": "color",
          "$value": "#a33a2c",
          "$extensions": {
            "de.smm.mode.dark": "#f08b7b"
          }
        }
      },
      "info": {
        "bg": {
          "$type": "color",
          "$value": "#e8eef7",
          "$extensions": {
            "de.smm.mode.dark": "#1f2836"
          }
        },
        "text": {
          "$type": "color",
          "$value": "#1d2327",
          "$extensions": {
            "de.smm.mode.dark": "#e8e6e1"
          }
        }
      }
    },
    "focus": {
      "ring": {
        "$type": "color",
        "$value": "#1f5f5b",
        "$extensions": {
          "de.smm.mode.dark": "#7cc3bb"
        }
      }
    }
  },
  "font": {
    "family": {
      "body": {
        "$type": "fontFamily",
        "$value": [
          "-apple-system",
          "BlinkMacSystemFont",
          "SF Pro Text",
          "Segoe UI",
          "Inter",
          "Helvetica",
          "Arial",
          "sans-serif"
        ],
        "$description": "OFFEN – Systemschrift als Arbeitswert, keine Lizenzfrage"
      },
      "mono": {
        "$type": "fontFamily",
        "$value": [
          "ui-monospace",
          "SF Mono",
          "Menlo",
          "monospace"
        ]
      }
    }
  },
  "text": {
    "body": {
      "md": {
        "$type": "dimension",
        "$value": "16px",
        "$description": "Fließtext ≥ 16 px (WCAG 2.2 AA)"
      }
    },
    "caption": {
      "$type": "dimension",
      "$value": "12px",
      "$description": "Untergrenze – nichts kleiner als 12 px"
    }
  },
  "size": {
    "target": {
      "min": {
        "$type": "dimension",
        "$value": "44px"
      },
      "min-pointer": {
        "$type": "dimension",
        "$value": "24px"
      }
    }
  },
  "radius": {
    "control": {
      "$type": "dimension",
      "$value": "8px"
    },
    "container": {
      "$type": "dimension",
      "$value": "10px"
    },
    "pill": {
      "$type": "dimension",
      "$value": "999px"
    }
  },
  "border": {
    "width": {
      "focus": {
        "$type": "dimension",
        "$value": "2px"
      }
    },
    "offset": {
      "focus": {
        "$type": "dimension",
        "$value": "2px"
      }
    }
  },
  "elevation": {
    "raised": {
      "$type": "shadow",
      "$value": "0 1px 2px rgba(20, 20, 10, 0.04), 0 2px 8px rgba(20, 20, 10, 0.04)",
      "$extensions": {
        "de.smm.mode.dark": "none"
      }
    }
  }
}